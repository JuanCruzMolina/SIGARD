# Entornos
.env
venv/
.venv/
node_modules/

# Datos locales (no versionar fuentes ni artefactos generados)
data/**
!data/README.md
!data/**/
!data/**/.gitkeep

# Entrega sanitaria autorizada y derivados privados (sin excepciones)
data/datos oficiales/
data/interim/official/
data/processed/official/
ml/configs/official.private.json
ml/artifacts/official/
!frontend/public/data/
!frontend/public/data/mvp_prediction.geojson
!frontend/public/data/mvp_prediction_summary.json
!frontend/public/data/mvp_backtest.json
*.xlsx
*.xls

# Modelos entrenados
ml/artifacts/
ml/models/*.pkl
ml/models/*.h5
ml/models/*.joblib

# Python
__pycache__/
*.pyc
*.db
.pytest_cache/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# Python packaging and test artifacts
ml/src/*.egg-info/
ml/.cache/
ml/.tmp/
ml/.pytest_cache/
ml/__pycache__/
**/__pycache__/
*.py[cod]

# Seguridad previa a integración: secretos, privados y derivados en cualquier nivel.
# Credenciales convencionales y datos espaciales fuera de las excepciones públicas.
**/.npmrc
**/.netrc
**/_netrc
**/.pypirc
**/.git-credentials
**/.aws/**
**/.ssh/**
**/.azure/**
**/.kube/**
**/.docker/**
**/.env
**/.env.*
**/*.env
**/*.env.*
**/.envrc
**/credentials
**/credentials.json
**/credentials.yaml
**/credentials.yml
**/credentials.toml
**/credentials.ini
**/secrets.json
**/secrets.yaml
**/secrets.yml
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.keystore
# Sólo plantillas explícitas; las reglas privadas de abajo tienen precedencia.
!**/.env.example
!**/credentials.example.*
!**/secrets.example.*
**/*.private
**/*.private.*
**/*.private-*
**/*_private
**/*_private.*
**/private
**/private.*
**/private/**
**/confidential/**
**/secrets/**
**/*.[xX][lL][sS]*
**/*.parquet
**/*.feather
**/*.arrow
**/*.joblib
