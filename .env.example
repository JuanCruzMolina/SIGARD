# Desarrollo local únicamente. Reemplazar por una contraseña aleatoria propia.
SIGARD_DB_PASSWORD=reemplazar-por-una-clave-larga-y-aleatoria
# Clave independiente para firmar tokens de la API (mínimo 32 caracteres).
SIGARD_SECRET_KEY=reemplazar-por-otra-clave-aleatoria-de-al-menos-32-caracteres

# Plazo de conservación de reportes ciudadanos. No afecta datasets epidemiológicos.
SIGARD_REPORT_RETENTION_DAYS=180

# URL pública que el navegador usará para comunicarse con FastAPI.
SIGARD_FRONTEND_API_URL=http://localhost:8000

# Orígenes locales autorizados para llamar a FastAPI desde el navegador.
SIGARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
